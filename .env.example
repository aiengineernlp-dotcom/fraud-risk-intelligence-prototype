# -----------------------------------------------------------------------------
# SoC layer      : Configuration
# Responsibility : List every environment variable the project reads, WITHOUT values
# Never does     : Hold a real value (a key, a URL with credentials, a password)
# Reference      : Architecture_Projet.md — section 4 (D-04), section 6, section 8 (n° 02)
# Usage          : cp .env.example .env   then fill .env only (.env is git-ignored)
# -----------------------------------------------------------------------------

# --- LLM client selection (D-04) ---------------------------------------------
# Allowed values: fake | openai_compatible
# "fake" runs offline with the scripted test client (no network, no cost).
LLM_PROVIDER=

# --- OpenAI-compatible provider (used only when LLM_PROVIDER=openai_compatible)
# Base URL of any provider or local server that speaks the OpenAI protocol.
LLM_BASE_URL=
# Model name as the provider expects it.
LLM_MODEL=
# Secret key. Never commit a value here; put it in .env only.
LLM_API_KEY=