# -----------------------------------------------------------------------------
# SoC layer      : Configuration
# Responsibility : Keep secrets, raw data, runtime data, trained models and
#                  machine/editor files out of version control
# Never does     : Exclude what must be submitted (data/demo/*.json,
#                  artifacts/metrics/, artifacts/figures/, .env.example)
# Reference      : Architecture_Projet.md — section 4 (D-15), section 8 (n° 01)
# -----------------------------------------------------------------------------

# --- Secrets (R246) -----------------------------------------------------------
# Real credentials live only in .env; the template without values is committed.
.env
.env.*
!.env.example
.streamlit/secrets.toml

# --- Data (D-15, R043, R321) --------------------------------------------------
# Raw PaySim download: never redistributed, see README "Dataset acquisition".
data/raw/
# SQLite database created when the app starts.
data/runtime/

# --- Trained model artefacts (D-15) -------------------------------------------
# Regenerated by `python -m src.train`; metrics and figures stay versioned.
artifacts/models/

# --- Python environment and caches --------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Test and notebook by-products --------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- Logs (may contain case data) ---------------------------------------------
*.log

# --- Editor and operating system files (I14) ----------------------------------
.idea/
.vscode/
.DS_Store
